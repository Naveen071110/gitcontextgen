# ==========================================
# GitContextGen Environment Configuration
# ==========================================

# Base Public App URL (Used for Canonical URLs, OpenGraph, and OAuth redirects)
NEXT_PUBLIC_APP_URL=https://gitcontextgen.com

# Supabase Authentication & Database
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# GitHub Personal Access Token (Optional: Increases API rate limit from 60 to 5,000 req/hr)
GITHUB_TOKEN=ghp_your_github_token_here

# GitHub Webhook Secret (Used to verify HMAC-SHA256 signatures on push events)
GITHUB_WEBHOOK_SECRET=your_github_webhook_secret_here

# Resend Email Broadcast API (Optional: Used for automated subscriber release notifications)
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM_EMAIL=updates@gitcontextgen.com

# AI Model API Keys (For Server-Side Context & Specification Synthesis)
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Dodo Payments (Merchant of Record Subscription & Checkout Flow)
# Set to 'test_mode' for local sandbox testing, or 'live_mode' for production
DODO_PAYMENTS_ENVIRONMENT=test_mode
NEXT_PUBLIC_DODO_MODE=test
DODO_PAYMENTS_API_KEY=your_dodo_api_key_here
DODO_PAYMENTS_WEBHOOK_SECRET=your_dodo_webhook_secret_here
DODO_PAYMENTS_WEBHOOK_KEY=your_dodo_webhook_key_here
DODO_PAYMENTS_RETURN_URL=https://gitcontextgen.com/success
