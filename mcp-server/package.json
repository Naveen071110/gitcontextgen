    "gitcontextgen",
    "claude-code",
    "cursor",
    "agents-md",
    "claude-md",
    "context-engine"
  ],
  "author": "GitContextGen Team",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.6.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^20.17.19",
    "typescript": "^5.7.3"
  }
}
